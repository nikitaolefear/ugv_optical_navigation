# Non-secret placeholders. Zero is deliberately invalid; do not install unchanged.
# UIDs must refer to three distinct preprovisioned nonroot service identities.
UGV_FRONTEND_UID=0
UGV_GATEWAY_UID=0
UGV_OWNER_UID=0
UGV_FRONTEND_RPC_GID=0
UGV_OWNER_RPC_GID=0

# Auth HMI 8083 settings: feature OFF initially; no direct owner socket fallback.
UGV_HMI_ENABLE_DISARM=0
UGV_DISARM_GATEWAY_SOCKET=/run/ugv-command/ingress.sock
UGV_DISARM_GATEWAY_UID=0
UGV_DISARM_FRONTEND_GID=0
UGV_HMI_TELEMETRY=0

# Keep actual PUBLIC_ORIGIN / Secure cookies / TRUST_PROXY configuration.
# This file contains no production secrets and grants no OS/RBAC permissions.
