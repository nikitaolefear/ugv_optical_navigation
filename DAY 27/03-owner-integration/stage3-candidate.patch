+"""Owner-local diagnostic gate. Serial access is injected by the sole owner."""
+from dataclasses import dataclass
+import json
+import os
+from pathlib import Path
+import queue
+import secrets
+import threading
+import time
+
+OPERATIONS = frozenset('S3_OPEN S3_START S3_RENEW S3_STOP S3_STATUS S3_LOG_ON S3_SRC2 S3_RESTORE'.split())
+IDLE = .75
+
+
+class Refused(RuntimeError):
+    pass
+
+
+class Trace:
+    def __init__(self, path, *, limit=2048, max_bytes=32 * 1024 * 1024, clock=time):
+        self.clock = clock
+        self.queue = queue.Queue(limit)
+        self.limit = max_bytes
+        self.failed = False
+        self.dropped = 0
+        self.closed = False
+        self.count = 0
+        self.fd = os.open(Path(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        self.worker = threading.Thread(target=self._drain, daemon=True)
+        self.worker.start()
+
+    def push(self, event, **fields):
+        if self.failed or self.closed:
+            self.dropped += 1
+            return False
+        try:
+            self.queue.put_nowait(dict(event=event, monotonic=self.clock.monotonic(),
+                                       utc_ns=self.clock.time_ns(), **fields))
+            return True
+        except queue.Full:
+            self.failed = True
+            self.dropped += 1
+            return False
+
+    def _drain(self):
+        try:
+            while not self.closed or not self.queue.empty():
+                try:
+                    row = self.queue.get(timeout=.05)
+                except queue.Empty:
+                    continue
+                data = (json.dumps(row, default=str) + '\n').encode()
+                if self.count + len(data) > self.limit or os.write(self.fd, data) != len(data):
+                    raise OSError('trace quota or partial write')
+                self.count += len(data)
+            os.fsync(self.fd)
+        except Exception:
+            self.failed = True
+            self.dropped += 1 + self.queue.qsize()
+        finally:
+            os.close(self.fd)
+
+    def close(self):
+        self.closed = True
+        self.worker.join(2)
+        if self.worker.is_alive():
+            self.failed = True
+
+
+@dataclass
+class Pending:
+    kind: str
+    value: int
+    deadline: float
+    sent: bool = False
+    ack: str | None = None
+    read_requested: bool = False
+
+
+class Stage3:
+    def __init__(self, *, clock, trace, baseline, guard, action, restore_eligible,
+                 hard_seconds=180, idle=IDLE, recording_proven=lambda: False, driver_queue_empty=lambda fd: False, source_reader=None):
+        self.clock, self.trace, self.baseline, self.guard = clock, trace, baseline, guard
+        self.action, self.restore_eligible = action, restore_eligible
+        self.hard_seconds, self.idle = hard_seconds, idle
+        self.recording_proven, self.driver_queue_empty = recording_proven, driver_queue_empty
+        self.driver_empty = True
+        self.source_reader = source_reader
+        self.renew_seq = 0
+        self.lock = threading.RLock()
+        self.token = self.peer = self.old = None
+        self.hard = self.until = 0.0
+        self.t0 = None
+        self.stopped = True
+        self.ended_at = None
+        self.write_fault = False
+        self.writes = 0
+        self.bytes_written = 0
+        self.last_write = None
+        self.pending = None
+        self.last_action = None
+        self.log_dirty = self.src_dirty = False
+        self.phase = 'A'
+        self.restoring = False
+        self.restore_failed = False
+
+    def _stop(self, reason):
+        if not self.stopped:
+            self.stopped = True
+            self.ended_at = self.clock()
+            self.trace.push('lease_stop', reason=reason, writes=self.writes)
+
+    def _expire(self):
+        if not self.stopped and (self.clock() >= min(self.hard, self.until)
+                                 or self.trace.failed or not self.guard()):
+            self._stop('LEASE_OR_GUARD_LOST')
+
+    def dispatch(self, peer, op, payload):
+        with self.lock:
+            self._expire()
+            now = self.clock()
+            if op == 'S3_OPEN':
+                if payload or self.token is not None or not self.guard() or self.trace.failed:
+                    raise Refused('OPEN_REFUSED')
+                baseline = self.baseline()
+                if baseline is None or baseline.get('source') not in (1, 2, 3) or type(baseline.get('log_disarmed')) is not int or baseline.get('log_disarmed') not in (0, 1, 2, 3):
+                    raise Refused('UNVERIFIED_BASELINE')
+                self.old, self.peer = dict(baseline), peer
+                self.token = secrets.token_hex(32)
+                self.hard, self.until = now + 30, now + self.idle
+                self.stopped = False
+                self.trace.push('lease_open', hard_end=self.hard)
+                return dict(token=self.token, baseline=self.old, hard_end=self.hard)
+            expected = {'token', 'phase', 'seq'} if op == 'S3_RENEW' else {'token'}
+            if op not in OPERATIONS or set(payload) != expected or self.token is None or peer != self.peer or not secrets.compare_digest(str(payload['token']), self.token):
+                raise Refused('SESSION_REFUSED')
+            if op == 'S3_STOP':
+                self._stop('EXPLICIT_STOP')
+            elif op == 'S3_RESTORE':
+                if not self.stopped or self.write_fault or not self.driver_empty or not self.restore_eligible():
+                    raise Refused('TX_STOP_OR_RESTORE_UNCONFIRMED')
