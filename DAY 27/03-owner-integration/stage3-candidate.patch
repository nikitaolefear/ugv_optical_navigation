+                                       count=n, message_id=102, sysid=packet[5] if len(packet) > 6 else None,
+                                       compid=packet[6] if len(packet) > 6 else None,
+                                       usec=int.from_bytes(packet[10:18], 'little') if packet[:1] == b'\xfd' and len(packet) >= 18 else None):
