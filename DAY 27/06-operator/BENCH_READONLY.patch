+"""Passive observations and single outstanding owner TIMESYNC request."""
+import math
+import re
+import time
+
+
+class ClockProbe:
+    def __init__(self, *, time_ns=time.time_ns, mono_ns=time.monotonic_ns):
+        self.utc_ns, self.mono_ns = time_ns, mono_ns
+        self.pending = None
+        self.last_nonce = 0
+        self.anchor = None
+        self.last_fc = None
+        self.fault = False
+
+    def poll(self, send):
+        if self.fault:
+            return False
+        t = self.mono_ns()
+        if self.pending and t - self.pending[1] <= 200_000_000:
+            return False
+        nonce = max(t, self.last_nonce + 1)
+        self.pending = (nonce, t, self.utc_ns())
+        self.last_nonce = nonce
+        try:
+            send(nonce)
+        except OSError:
+            self.pending = None
+            raise
+        return True
+
+    def observe(self, msg):
+        if (msg.get_srcSystem(), msg.get_srcComponent()) != (1, 1):
+            return
+        if msg.get_type() == 'SYSTEM_TIME':
+            # Passive reset evidence, not a round-trip timing anchor.
+            current = int(msg.time_boot_ms)
+            if self.last_fc is not None and current < self.last_fc:
+                self.fault = True
+            self.last_fc = current
+        if msg.get_type() != 'TIMESYNC' or self.pending is None:
+            return
+        nonce, start, utc = self.pending
+        if msg.ts1 != nonce or msg.tc1 <= 0:
+            return
+        # Rover 4.7.2 may reply without target extensions.
+        if (getattr(msg, 'target_system', 0), getattr(msg, 'target_component', 0)) not in ((0, 0), (255, 190)):
+            return
+        self.pending = None
+        end, utc_end = self.mono_ns(), self.utc_ns()
+        span = end - start
+        if not 0 <= span <= 190_000_000 or abs((utc_end - utc) - span) > 10_000_000:
+            self.fault = True
+            return
+        if self.anchor and (msg.tc1 <= self.anchor['fc_ns'] or
+                abs((msg.tc1 - self.anchor['fc_ns']) - (start - self.anchor['before_ns']))
+                > span + self.anchor['error_ns'] * 2 + 100_000_000):
+            self.fault = True
+            return
+        self.anchor = dict(before_ns=start, after_ns=end, utc_mid_ns=(utc+utc_end)//2,
+                           fc_ns=msg.tc1, error_ns=span//2 + 5_000_000)
+
+    def at(self, now):
+        a = self.anchor
+        if self.fault or a is None or not 0 <= now - a['after_ns'] <= 3_000_000_000:
+            return None
+        midpoint = (a['before_ns'] + a['after_ns']) // 2
+        return a['fc_ns'] + now - midpoint, a['error_ns'] + abs(now-midpoint)//10000
+
+
+class SourceObserver:
+    line = re.compile(r'S3SRC1 ([012]) ([0-9]{1,10})')
+
+    def __init__(self, probe, *, provenance=None):
+        self.probe = probe
+        self.provenance = provenance  # Explicit verified board/script identity; no default trust.
+        self.last = None
+
+    def observe(self, msg):
+        if (self.provenance is None or not self.provenance()
+                or (msg.get_srcSystem(), msg.get_srcComponent()) != (1, 1)
+                or msg.get_type() != 'STATUSTEXT' or getattr(msg, 'chunk_seq', 0)):
+            return
+        match = self.line.fullmatch(msg.text)
+        if match is None:
+            return
+        now = self.probe.mono_ns()
+        mapped = self.probe.at(now)
+        stamp = int(match[2]) * 1_000_000
+        if mapped is None or not 0 <= int(match[2]) < 2**32:
+            return
+        fc, error = mapped
+        if not -error <= fc - stamp <= 600_000_000 + error:
+            return
+        if self.last and stamp <= self.last[1]:
+            return
+        self.last = (int(match[1]) + 1, stamp, now)
+
+    def read(self):
+        now = self.probe.mono_ns()
+        if (self.last is None or self.provenance is None or not self.provenance()
+                or self.probe.at(now) is None or not 0 <= now - self.last[2] < 1_000_000_000):
+            return None
+        return self.last[0]
