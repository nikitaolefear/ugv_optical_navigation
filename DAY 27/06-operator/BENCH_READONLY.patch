+"""Bounded operator requests serviced exclusively by the owner tick."""
+import base64
+import threading
+
+from .stage3 import Refused
+from .stage3_log_transport import Job, LogTransport, MAX_PREFIX
+from .stage3_observers import ClockProbe, SourceObserver
+
+OPS = frozenset({'S3_BENCH_STATUS', 'S3_BENCH_REQUEST', 'S3_BENCH_RESULT', 'S3_BENCH_CHUNK'})
+PARAMETERS = {'log_disarmed':'LOG_DISARMED', 'scr_enable':'SCR_ENABLE', 'scr_heap_size':'SCR_HEAP_SIZE'}
+
+
+class BenchOperator:
+    def __init__(self, mode, clock, guard, status, *, pi_boot, provenance=None):
+        if mode not in ('B1', 'B2'):
+            raise ValueError('invalid operator mode')
+        self.mode, self.clock, self.guard, self.status = mode, clock, guard, status
+        self.pi_boot = pi_boot
+        self.probe = ClockProbe()
+        self.source = SourceObserver(self.probe, provenance=provenance)
+        self.logs = LogTransport(clock)
+        self.lock = threading.RLock()
+        self.peer = self.job = self.result = None
+        self.deadline = 0
+
+    def dispatch(self, peer, op, payload):
+        with self.lock:
+            if op == 'S3_BENCH_STATUS' and not payload:
+                return dict(mode=self.mode, readonly=True, pi_boot=self.pi_boot,
+                            lua_src=self.source.read(), clock_fault=self.probe.fault,
+                            **self.status())
+            if self.mode != 'B2':
+                raise Refused('B1_READONLY_TRANSPORT_DISABLED')
+            if op == 'S3_BENCH_REQUEST':
+                kind = payload.get('kind')
+                if not isinstance(kind, str):
+                    raise Refused('INVALID_DIAGNOSTIC_REQUEST')
+                if (set(payload) != ({'kind', 'id', 'size'} if kind == 'prefix' else {'kind'})
+                        or kind not in {'catalog', 'prefix', 'timesync', 'memory', *PARAMETERS}):
+                    raise Refused('INVALID_DIAGNOSTIC_REQUEST')
+                if self.job is not None or self.logs.busy or not self.guard():
+                    raise Refused('BUSY_OR_UNSAFE')
+                if kind == 'prefix' and (type(payload['id']) is not int or not 0 <= payload['id'] <= 65535
+                                         or type(payload['size']) is not int or not 0 < payload['size'] <= MAX_PREFIX):
+                    raise Refused('INVALID_PREFIX_LIMIT')
+                self.result = None
+                self.peer, self.job = peer, dict(payload)
+                self.deadline = self.clock() + 30
+                return {'queued': True, 'kind': kind}
+            if peer != self.peer:
+                raise Refused('REQUEST_PEER_MISMATCH')
+            if op == 'S3_BENCH_RESULT' and not payload:
+                return {'busy': self.job is not None, 'result': self.result}
+            if op == 'S3_BENCH_CHUNK' and set(payload) == {'offset'}:
+                offset = payload['offset']
+                if (not self.result or self.result.get('kind') != 'prefix'
+                        or self.result.get('reason') != 'COMPLETE' or type(offset) is not int
+                        or not 0 <= offset < len(self.logs.data)):
+                    raise Refused('PREFIX_UNAVAILABLE')
+                return {'offset': offset, 'base64': base64.b64encode(self.logs.data[offset:offset + 768]).decode()}
+            raise Refused('INVALID_DIAGNOSTIC_REQUEST')
+
+    def observe(self, message):
+        # Both RX and tick run on the sole MAVLink owner thread.
+        with self.lock:
+            self.probe.observe(message)
+            self.source.observe(message)
+            self.logs.observe(message)
+            if not self.job or not self.job.get('sent'):
+                return
+            kind = self.job['kind']
+            if self.clock() >= self.deadline or not self.guard():
+                return
+            if (kind in PARAMETERS and message.get_type() == 'PARAM_VALUE'
+                    and (message.get_srcSystem(), message.get_srcComponent()) == (1, 1)
+                    and message.param_id == PARAMETERS[kind]):
+                value = message.param_value
+                bounds = {'log_disarmed': (0, 3), 'scr_enable': (0, 1), 'scr_heap_size': (1024, 1048576)}
+                lo, hi = bounds[kind]
+                if lo <= value <= hi and value == int(value):
+                    self.result = dict(kind=kind, value=int(value), observed_at=self.clock())
+                    self.job = None
+            elif (kind == 'memory' and message.get_type() == 'MEMINFO'
+                  and (message.get_srcSystem(), message.get_srcComponent()) == (1, 1)):
+                self.result = dict(kind=kind, freemem=message.freemem,
+                                   freemem32=getattr(message, 'freemem32', 0), observed_at=self.clock())
+                self.job = None
+            elif (kind == 'timesync' and self.probe.anchor is not None
+                  and self.probe.anchor['before_ns'] == self.job['sent'] and not self.probe.fault):
+                self.result = dict(kind=kind, pi_boot=self.pi_boot, **self.probe.anchor)
+                self.job = None
+
+    def tick(self, send, *, connected, priority_clear):
+        with self.lock:
+            if not self.job:
+                return
+            kind = self.job['kind']
+            safe = connected and self.guard()
+            try:
+                if self.logs.busy:
+                    self.logs.tick(send, safe=safe, connected=connected, priority_clear=priority_clear)
+                    if not self.logs.busy:
+                        result = self.logs.result
+                        # Max reply is bounded even for a full 500-entry catalog.
+                        cat = result.pop('catalog')
+                        self.result = dict(kind=kind, **result, count=len(cat))
+                        self.result['entries'] = [[i, *value] for i, value in sorted(cat.items())]
+                        self.job = None
+                    return
+                if not safe or self.clock() >= self.deadline:
+                    self.result = dict(kind=kind, reason='GUARD_OR_DEADLINE')
+                    self.job = None
+                    return
+                if not priority_clear or self.job.get('sent'):
+                    return
+                if kind in ('catalog', 'prefix'):
+                    self.logs.start(Job() if kind == 'catalog' else Job(self.job['id'], self.job['size']),
+                                    permitted=True)
+                elif kind == 'timesync':
+                    if self.probe.poll(lambda nonce: send('timesync', nonce)):
+                        self.job['sent'] = self.probe.pending[1]
+                else:
+                    send(kind)
+                    self.job['sent'] = True
+            except OSError:
+                if self.logs.busy:
+                    # A partial request may have reached the FC. END is still owed.
+                    self.logs.finished = 'SERIAL_WRITE_FAILED'
+                else:
+                    self.result = dict(kind=kind, reason='SERIAL_WRITE_FAILED')
+                    self.job = None
