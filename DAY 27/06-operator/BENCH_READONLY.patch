+"""Serialized, bounded catalog / prefix transfer on the owner thread."""
+import hashlib
+from dataclasses import dataclass
+
+MAX_PREFIX = 512 * 1024
+CHUNK = 900
+
+
+@dataclass(frozen=True)
+class Job:
+    identifier: int | None = None
+    size: int = 0
+
+
+class LogTransport:
+    def __init__(self, clock):
+        self.clock = clock
+        self.job = None
+        self.entries = {}
+        self.expected = None
+        self.data = bytearray()
+        self.next = self.end = self.deadline = 0
+        self.requested = False
+        self.opened = False
+        self.finished = None
+        self.result = None
+
+    @property
+    def busy(self):
+        return self.job is not None
+
+    def start(self, job, *, permitted):
+        if not permitted or self.busy:
+            raise RuntimeError('log transfer not permitted or already active')
+        if (not isinstance(job, Job)
+                or (job.identifier is None and job.size != 0)
+                or (job.identifier is not None and
+                    (type(job.identifier) is not int or not 0 <= job.identifier <= 65535
+                     or type(job.size) is not int or not 0 < job.size <= MAX_PREFIX))):
+            raise ValueError('invalid catalog/prefix job')
+        self.entries, self.data = {}, bytearray()
+        self.expected = self.finished = self.result = None
+        self.requested = self.opened = False
+        self.next = self.end = 0
+        self.deadline = self.clock() + 30
+        self.job = job
+
+    def observe(self, msg):
+        if not self.busy or not self.requested or self.finished is not None:
+            return
+        if (msg.get_srcSystem(), msg.get_srcComponent()) != (1, 1):
+            return
+        kind = msg.get_type()
+        if self.job.identifier is None and kind == 'LOG_ENTRY':
+            if self.expected is None:
+                self.expected = msg.num_logs
+            if msg.num_logs != self.expected or self.expected > 500:
+                self.finished = 'CATALOG_CHANGED'
+                return
+            entry = (msg.size, msg.time_utc)
+            if msg.id in self.entries and self.entries[msg.id] != entry:
+                self.finished = 'CATALOG_CHANGED'
+                return
+            if self.expected:
+                self.entries[msg.id] = entry
+            if len(self.entries) == self.expected:
+                self.finished = 'COMPLETE'
+        elif self.job.identifier is not None and kind == 'LOG_DATA' and msg.id == self.job.identifier:
+            if msg.ofs != len(self.data):
+                return
+            if not 0 < msg.count <= min(90, len(msg.data), self.end - len(self.data)):
+                self.finished = 'BAD_PREFIX_PACKET'
+                return
+            self.data.extend(bytes(msg.data[:msg.count]))
+            self.next = self.clock() + 1
+            if len(self.data) == self.job.size:
+                self.finished = 'COMPLETE'
+            elif len(self.data) == self.end:
+                self.next = 0
+
+    def tick(self, send, *, safe, connected, priority_clear):
+        if not self.busy:
+            return
+        now = self.clock()
+        if self.finished is None and (not safe or now >= self.deadline):
+            self.finished = 'GUARD_OR_DEADLINE'
+        if self.finished is not None:
+            if self.opened:
+                if not connected or not priority_clear:
+                    return  # Remain interlocked. No TX while END is still owed.
+                send('end')
+            self.result = dict(reason=self.finished, log_id=self.job.identifier,
+                               end_sent=self.opened, catalog=dict(self.entries),
+                               bytes_received=len(self.data),
+                               sha256=hashlib.sha256(self.data).hexdigest())
+            self.job = None
+            return
+        if not priority_clear or now < self.next:
+            return
+        self.opened = self.requested = True  # Even a partial write can have sent a request.
+        if self.job.identifier is None:
+            send('list')
+        else:
+            offset = len(self.data)
+            if offset == self.end:
+                self.end = min(offset + CHUNK, self.job.size)
+            send('data', self.job.identifier, offset, self.end - offset)
+        self.next = now + 1
