+            or anchors[-1]['pi_monotonic'] < t1
+            or len({r['boot_id'] for r in anchors}) != 1
+            or any(not 0 <= r['uncertainty_s'] <= .1 for r in anchors)):
+        return {'status': 'INCONCLUSIVE', 'reason': 'CLOCK_ANCHORS_MISSING'}
