+"""Durable, fail-closed journal for a single diagnostic owner session."""
+import hashlib
+import fcntl
+import hmac
+import json
+import os
+from pathlib import Path
+import secrets
+import queue
+import threading
+import stat
+import time
+
+
+def encoded(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False).encode()
+
+
+class BaselineStore:
+    def __init__(self, path, profile):
+        self.path = Path(path)
+        self.profile = profile
+        self.record = None
+        self.blocked = True
+        self.failed = False
+        self.updates = queue.Queue(32)
+        self.worker = None
+        try:
+            parent = self.path.parent.lstat()
+            if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.getuid() or parent.st_mode & 0o077:
+                return
+            with os.fdopen(os.open(self.path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), 'rb') as f:
+                st = os.fstat(f.fileno())
+                if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1 or st.st_mode & 0o077:
+                    return
+                envelope = json.loads(f.read(16385))
+            r = envelope['record']
+            if (not hmac.compare_digest(envelope['sha256'], hashlib.sha256(encoded(r)).hexdigest())
+                    or r['version'] != 1 or r['rollback'] not in ('PENDING', 'RESTORING', 'COMPLETED')
+                    or not r['session'] or not r['profile'] or r['baseline']['source'] not in (1, 2, 3)
+                    or r['baseline']['log_disarmed'] not in (0, 1, 2, 3)
+                    or r['planned'] != ['LOG_DISARMED', 'SRC']
+                    or not isinstance(r['confirmed'], list) or not isinstance(r['updated_utc_ns'], int)):
+                return
+            self.record = r
+            self.blocked = r['rollback'] != 'COMPLETED'
+        except (OSError, ValueError, KeyError, TypeError):
+            # Including a missing journal: explicit provisioning is required.
+            pass
+
+    @classmethod
+    def provision(cls, path, profile, baseline):
+        """Offline/install-time initialization with independently captured baseline."""
+        store = cls(path, profile)
+        if store.path.exists() or store.path.is_symlink():
+            raise FileExistsError(path)
+        if not profile or baseline.get('source') not in (1, 2, 3) or baseline.get('log_disarmed') not in (0, 1, 2, 3):
+            raise ValueError('unverified initial baseline')
+        parent = store.path.parent.lstat()
+        if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.getuid() or parent.st_mode & 0o077:
+            raise PermissionError('private owned directory required')
+        store._save(store._new('provisioned', baseline, 'COMPLETED'), create=True)
+        return cls(path, profile)
+
+    def _new(self, session, baseline, state):
+        return dict(version=1, session=session, profile=self.profile, baseline=dict(baseline),
+                    planned=['LOG_DISARMED', 'SRC'], confirmed=[], rollback=state,
+                    created_utc_ns=time.time_ns(), created_monotonic_ns=time.monotonic_ns())
+
+    def _save(self, record, *, create=False):
+        record = dict(record, updated_utc_ns=time.time_ns(), updated_monotonic_ns=time.monotonic_ns())
+        path = self.path.with_name(f'.{self.path.name}.{secrets.token_hex(8)}')
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        try:
+            with os.fdopen(fd, 'wb') as f:
+                f.write(encoded(dict(record=record, sha256=hashlib.sha256(encoded(record)).hexdigest())))
+                f.flush()
+                os.fsync(f.fileno())
+            if create:
+                os.link(path, self.path)
+            else:
+                os.replace(path, self.path)
+            parent_fd = os.open(self.path.parent, os.O_DIRECTORY | os.O_NOFOLLOW)
+            try:
+                os.fsync(parent_fd)
+            finally:
+                os.close(parent_fd)
