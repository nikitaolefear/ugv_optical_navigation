+"""Offline clock interval mapping with explicit transport uncertainty."""
+from dataclasses import dataclass
+import math
+
+
+@dataclass(frozen=True)
+class Anchor:
+    boot_pi: str
+    boot_fc: str
+    before_pi: float
+    after_pi: float
+    utc_pi: float  # Clock read at midpoint (or bracket-calibrated equivalent).
+    fc_time_us: int  # Source boot clock, independently tied to DataFlash TimeUS.
+    extra_error_s: float = .001
+
+    def brackets(self):
+        if (not self.boot_pi or not self.boot_fc or self.fc_time_us < 0
+                or not all(math.isfinite(v) for v in (self.before_pi, self.after_pi, self.utc_pi, self.extra_error_s))
+                or not 0 <= self.before_pi <= self.after_pi or self.extra_error_s < 0):
+            raise ValueError('invalid anchor')
+        span = self.after_pi - self.before_pi
+        error = span / 2 + self.extra_error_s
+        if error > .1:
+            raise ValueError('unbounded transport error')
+        pi = (self.before_pi + self.after_pi) / 2
+        return pi, self.fc_time_us / 1e6 - pi, self.utc_pi - pi, error
+
+
+def map_window(t0, t1, anchors, *, rate_error_ppm=100):
+    if (not math.isfinite(rate_error_ppm) or not 0 <= rate_error_ppm <= 1000 or
+            len(anchors) < 2 or not 0 <= t0 < t1):
+        raise ValueError('invalid window')
+    if len({(a.boot_pi, a.boot_fc) for a in anchors}) != 1:
+        raise ValueError('boot epoch changed')
+    ordered = sorted(((a.brackets(), a.fc_time_us) for a in anchors))
+    if ordered[0][0][0] > t0 or ordered[-1][0][0] < t1:
+        raise ValueError('anchors do not bracket test')
+    for (left, lfc), (right, rfc) in zip(ordered, ordered[1:]):
+        drift = (right[0] - left[0]) * rate_error_ppm / 1e6
+        bound = left[3] + right[3] + drift
+        if right[0] <= left[0] or rfc <= lfc or abs(left[1]-right[1]) > bound:
+            raise ValueError('Pixhawk clock discontinuity')
+        if abs(left[2]-right[2]) > bound:
+            raise ValueError('UTC step')
+    def mapped(t):
+        nearest = min((a for a, _ in ordered), key=lambda a: abs(t-a[0]))
+        error = nearest[3] + abs(t-nearest[0]) * rate_error_ppm / 1e6
+        if error > .1:
+            raise ValueError('window uncertainty too large')
+        return dict(pi_monotonic=t, pi_utc=t + nearest[2],
+                    pixhawk_time_us=round((t + nearest[1]) * 1e6), error_s=error)
+    return dict(start=mapped(t0), end=mapped(t1))
