+"""Offline recovery plan; live recovery requires a reviewed owner-local port."""
+import argparse
+import hashlib
+import fcntl
+import os
+import stat
+import json
+from pathlib import Path
+
+from disarm_control.stage3_baseline import BaselineStore
+
+
+def recover(path, profile, port, *, authorize, audit):
+    """Execute an explicitly authorized recovery through an injected owner port.
+
+    The port must enforce no new diagnostic TX and persist audit records.
+    """
+    path = Path(path)
+    parent = path.parent.lstat()
+    if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.getuid() or parent.st_mode & 0o077:
+        raise PermissionError('private rollback directory required')
+    fd = os.open(path.with_name(path.name + '.lock'),
+                 os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
+    try:
+        st = os.fstat(fd)
+        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1 or st.st_mode & 0o077:
+            raise PermissionError('invalid rollback lock')
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        return _recover_locked(path, profile, port, authorize=authorize, audit=audit)
+    finally:
+        os.close(fd)
+
+
+def _recover_locked(path, profile, port, *, authorize, audit):
+    store = BaselineStore(path, profile)
+    record = store.record
+    if record is None or record['rollback'] not in ('PENDING', 'RESTORING') or record['profile'] != profile:
+        raise RuntimeError('no verified unfinished journal')
+    original = record['baseline']
+    if not authorize(record['session'], profile):
+        raise PermissionError('recovery unauthorized')
+    def check():
+        state = port.safety()
+        if not all(state.get(k) is True for k in ('isolated', 'hold', 'disarmed', 'inhibit',
+                                                  'stop_latch', 'tx_barrier', 'driver_empty',
+                                                  'no_new_lease')):
+            raise RuntimeError('TX stop or safety unconfirmed')
+    check()
+    audit('recovery_begin', session=record['session'])
+    confirmed = list(record['confirmed'])
+    store.checkpoint(confirmed, 'RESTORING')
+    try:
+        # Both planned writes could have reached the FC before an owner crash.
+        for name, before in [('source', original['source']), ('log_disarmed', original['log_disarmed'])]:
+            check()
+            current = port.read(name)
+            if type(current) is not int or current not in ((1, 2, 3) if name == 'source' else (0, 1, 2, 3)):
+                raise RuntimeError(f'independent readback unavailable: {name}')
+            if current != before:
+                audit('restore_intent', name=name, value=before)
+                port.restore(name, before)
+            if port.read(name) != before:
+                raise RuntimeError(f'restore readback mismatch: {name}')
+            confirmed.append(dict(kind=name, value=before, restoring=True))
+            store.checkpoint(confirmed, 'RESTORING')
+        check()
+        if port.restore_and_verify_profile(profile) is not True:
+            raise RuntimeError('profile restore unconfirmed')
+        audit('restoration_readback_confirmed', session=record['session'])
+        store.checkpoint(confirmed, 'COMPLETED')
+        return True
+    except Exception as exc:
+        audit('recovery_failed', reason=str(exc))
+        raise
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('baseline', type=Path)
+    parser.add_argument('--profile', required=True)
+    a = parser.parse_args()
+    s = BaselineStore(a.baseline, a.profile)
+    print(json.dumps(dict(live='disabled', file_sha256=hashlib.file_digest(a.baseline.open('rb'), 'sha256').hexdigest()
+                          if s.record is not None else None, blocked=s.blocked, journal=s.record), indent=2))
