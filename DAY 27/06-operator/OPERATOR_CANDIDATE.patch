+"""Owner-local diagnostic gate. Serial access is injected by the sole owner."""
+from dataclasses import dataclass
+import json
+import hashlib
+import os
+from pathlib import Path
+import queue
+import secrets
+import threading
+import time
+
+OPERATIONS = frozenset('S3_OPEN S3_START S3_RENEW S3_STOP S3_STATUS S3_LOG_ON S3_SRC2 S3_RESTORE'.split())
+IDLE = .75
+
+
+class Refused(RuntimeError):
+    pass
+
+
+class Trace:
+    def __init__(self, path, *, limit=2048, max_bytes=32 * 1024 * 1024, clock=time):
+        self.clock = clock
+        self.queue = queue.Queue(limit)
+        self.limit = max_bytes
+        self.failed = False
+        self.dropped = 0
+        self.closed = False
+        self.count = 0
+        self.fd = os.open(Path(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        self.worker = threading.Thread(target=self._drain, daemon=True)
+        self.worker.start()
+
+    def push(self, event, **fields):
+        if self.failed or self.closed:
+            self.dropped += 1
+            return False
+        try:
+            self.queue.put_nowait(dict(event=event, monotonic=self.clock.monotonic(),
+                                       utc_ns=self.clock.time_ns(), **fields))
+            return True
+        except queue.Full:
+            self.failed = True
+            self.dropped += 1
+            return False
+
+    def _drain(self):
+        try:
+            while not self.closed or not self.queue.empty():
+                try:
+                    row = self.queue.get(timeout=.05)
+                except queue.Empty:
+                    continue
+                data = (json.dumps(row, default=str) + '\n').encode()
+                if self.count + len(data) > self.limit or os.write(self.fd, data) != len(data):
+                    raise OSError('trace quota or partial write')
+                self.count += len(data)
+            os.fsync(self.fd)
+        except Exception:
+            self.failed = True
+            self.dropped += 1 + self.queue.qsize()
+        finally:
+            os.close(self.fd)
+
+    def close(self):
+        self.closed = True
+        self.worker.join(2)
+        if self.worker.is_alive():
+            self.failed = True
+
+
+@dataclass
+class Pending:
+    kind: str
+    value: int
+    deadline: float
+    sent: bool = False
+    ack: str | None = None
+    read_requested: bool = False
+
+
+class Stage3:
+    def __init__(self, *, clock, trace, baseline, guard, action, restore_eligible,
+                 hard_seconds=180, idle=IDLE, recording_proven=lambda: False, driver_queue_empty=lambda fd: False, source_reader=None, store=None, profile_verifier=None):
+        self.clock, self.trace, self.baseline, self.guard = clock, trace, baseline, guard
+        self.action, self.restore_eligible = action, restore_eligible
+        self.hard_seconds, self.idle = hard_seconds, idle
+        self.recording_proven, self.driver_queue_empty = recording_proven, driver_queue_empty
+        self.driver_empty = True
+        self.source_reader = source_reader
+        self.store = store
+        self.profile_verifier = profile_verifier
+        self.write_active = False
+        self.confirmed = []
+        self.journal_error = False
+        self.renew_seq = 0
+        self.lock = threading.RLock()
+        self.token = self.peer = self.old = None
+        self.hard = self.until = 0.0
+        self.t0 = None
+        self.stopped = True
+        self.ended_at = None
+        self.write_fault = False
+        self.writes = 0
+        self.bytes_written = 0
+        self.last_write = None
+        self.pending = None
+        self.last_action = None
+        self.log_dirty = self.src_dirty = False
+        self.phase = 'A'
+        self.restoring = False
+        self.restore_failed = False
+
+    def _stop(self, reason):
+        if not self.stopped:
+            self.stopped = True
+            self.ended_at = self.clock()
+            self.trace.push('lease_stop', reason=reason, writes=self.writes)
+
+    def _expire(self):
+        if not self.stopped and (self.clock() >= min(self.hard, self.until)
+                                 or self.trace.failed or self.journal_error or (self.store is not None and self.store.failed) or not self.guard()):
+            self._stop('LEASE_OR_GUARD_LOST')
+
+    def dispatch(self, peer, op, payload):
+        with self.lock:
+            self._expire()
+            now = self.clock()
+            if op == 'S3_OPEN':
+                if payload or self.token is not None or not self.guard() or self.trace.failed:
+                    raise Refused('OPEN_REFUSED')
+                baseline = self.baseline()
+                if baseline is None or baseline.get('source') not in (1, 2, 3) or type(baseline.get('log_disarmed')) is not int or baseline.get('log_disarmed') not in (0, 1, 2, 3):
+                    raise Refused('UNVERIFIED_BASELINE')
+                token = secrets.token_hex(32)
+                if self.store is not None:
+                    self.store.start(hashlib.sha256(token.encode()).hexdigest(), baseline)
+                self.old, self.peer = dict(baseline), peer
+                self.token = token
+                self.hard, self.until = now + 30, now + self.idle
+                self.stopped = False
+                self.trace.push('lease_open', hard_end=self.hard)
+                return dict(token=self.token, baseline=self.old, hard_end=self.hard)
+            expected = {'token', 'phase', 'seq'} if op == 'S3_RENEW' else {'token'}
+            if op not in OPERATIONS or set(payload) != expected or self.token is None or peer != self.peer or not secrets.compare_digest(str(payload['token']), self.token):
+                raise Refused('SESSION_REFUSED')
+            if op == 'S3_STOP':
+                self._stop('EXPLICIT_STOP')
+            elif op == 'S3_RESTORE':
+                if not self.stopped or self.write_active or self.write_fault or not self.driver_empty or not self.restore_eligible():
+                    raise Refused('TX_STOP_OR_RESTORE_UNCONFIRMED')
+                self.restoring = True
+            elif op != 'S3_STATUS':
+                if self.stopped:
+                    raise Refused('EXPIRED')
+                if op == 'S3_START':
+                    if (not self.recording_proven() or self.t0 is not None or self.pending is not None or
+                            (self.old['log_disarmed'] != 1 and
+                             (self.last_action or {}).get('readback') != 'PARAM_VALUE')):
+                        raise Refused('PREFLIGHT_INCOMPLETE')
+                    self.t0 = now
+                    self.hard = now + self.hard_seconds
+                elif op == 'S3_RENEW':
+                    phase = payload['phase']
+                    elapsed = 0 if self.t0 is None else now - self.t0
+                    if phase == 'B' and elapsed < 30 or phase == 'C' and elapsed < 90:
+                        raise Refused('PHASE_TOO_EARLY')
+                    if phase not in ('A', 'B', 'C') or 'ABC'.index(phase) not in ('ABC'.index(self.phase), 'ABC'.index(self.phase) + 1):
+                        raise Refused('PHASE_REFUSED')
+                    seq = payload['seq']
+                    if type(seq) is not int or seq != self.renew_seq + 1:
+                        raise Refused('RENEW_SEQUENCE_REFUSED')
+                    self.renew_seq = seq
+                    self.phase = phase
+                    self.until = min(now + self.idle, self.hard)
+                    self.trace.push('lease_renew', phase=phase, idle_end=self.until)
+                else:
+                    if self.pending is not None:
+                        raise Refused('ACTION_BUSY')
+                    if op == 'S3_LOG_ON' and self.phase == 'A' and not self.log_dirty:
+                        if self.old['log_disarmed'] != 1:
+                            self.log_dirty = True
+                            self.pending = Pending('log', 1, now + 2)
+                    elif op == 'S3_SRC2' and self.phase == 'C' and not self.src_dirty:
+                        if self.old['source'] != 2:
+                            self.src_dirty = True
+                            self.pending = Pending('src', 2, now + 2)
+                    else:
+                        raise Refused('ACTION_REFUSED')
+            return self.status()
+
+    def status(self):
+        with self.lock:
+            return dict(stopped=self.stopped, tx_barrier=self.stopped and not self.write_active and not self.write_fault,
+                    driver_empty=self.driver_empty, writes=self.writes, bytes_written=self.bytes_written, last_write=self.last_write,
+                    stopped_at=self.ended_at, trace_failed=self.trace.failed,
+                    trace_dropped=self.trace.dropped, phase=self.phase, hard_end=self.hard,
+                    action=self.last_action, restored=self.restoring and not self.restore_failed
+                    and not self.log_dirty and not self.src_dirty and self.pending is None,
+                    restore_failed=self.restore_failed or self.journal_error or (self.store is not None and self.store.failed))
+
+    def archive_rollback(self, restored_profile):
+        with self.lock:
+            if (self.store is None or self.old is None or not self.status()['restored']
+                    or restored_profile != self.store.profile or self.profile_verifier is None
+                    or self.profile_verifier(restored_profile) is not True):
+                raise Refused('ROLLBACK_NOT_INDEPENDENTLY_CONFIRMED')
+            if self.store.failed:
+                raise Refused('JOURNAL_WRITE_FAILED')
+            self.store.note(self.confirmed, 'COMPLETED')
+
+
+    def link_lost(self):
+        with self.lock:
+            self._stop('OWNER_LINK_LOST')
+
+    def can_tick(self):
+        with self.lock:
+            self._expire()
+            if not self.stopped and self.phase in ('B', 'C') and self.source_reader is not None:
+                source = self.source_reader()
+                if self.phase == 'B' and source != self.old['source']:
+                    self._stop('BASELINE_SRC_LOST')
+                elif self.phase == 'C' and source not in (None, self.old['source'], 2):
+                    self._stop('UNEXPECTED_SRC')
+            return not self.stopped and self.phase in ('B', 'C')
+
+    def write_tx(self, writer, fd, packet):
+        # Reserve exactly one syscall before releasing the state lock. The stop
+        # reply can close the gate immediately but cannot confirm an in-flight write.
+        with self.lock:
+            if not self.can_tick() or self.write_active:
+                raise OSError('diagnostic lease closed or write in progress')
+            if not self.trace.push('packet', direction='TX_VPE_INTENT', raw=packet.hex()):
+                self._stop('TRACE_LOST')
+                raise OSError('trace unhealthy')
+            self.write_active = True
+            self.driver_empty = False
+        try:
+            n = writer(fd, packet)
+            with self.lock:
+                self.last_write = self.clock()
+                self.bytes_written += n
+                self.writes += 1
+                if n != len(packet):
+                    raise OSError('partial serial write')
+                if not self.trace.push('packet', direction='TX', raw=packet.hex(), count=n,
+                                       message_id=102, sysid=packet[5] if len(packet) > 6 else None,
+                                       compid=packet[6] if len(packet) > 6 else None,
+                                       usec=int.from_bytes(packet[10:18], 'little')
+                                       if packet[:1] == b'\xfd' and len(packet) >= 18 else None):
+                    raise OSError('TX trace lost')
+            return n
+        except BaseException:
+            with self.lock:
+                self.write_fault = True
+                self._stop('SERIAL_OR_TRACE_WRITE_FAULT')
+            raise
+        finally:
+            with self.lock:
+                self.write_active = False
+
+    def observe(self, message):
+        with self.lock:
+            if self.token is None:
+                return
+            kind = message.get_type()
+            if kind in {'HEARTBEAT', 'COMMAND_ACK', 'EKF_STATUS_REPORT', 'LOCAL_POSITION_NED',
+                        'GPS_GLOBAL_ORIGIN', 'HOME_POSITION', 'PARAM_VALUE', 'SYSTEM_TIME',
+                        'ATTITUDE', 'STATUSTEXT', 'TIMESYNC'}:
+                self.trace.push('packet', direction='RX', message_id=message.get_msgId(),
+                                sysid=message.get_srcSystem(), compid=message.get_srcComponent(),
+                                raw=bytes(message.get_msgbuf()).hex(), fields=message.to_dict())
+            if (message.get_srcSystem(), message.get_srcComponent()) != (1, 1):
+                return
+            p = self.pending
+            if p is None or not p.sent or self.clock() >= p.deadline:
+                return
+            if p.kind == 'log' and kind == 'PARAM_VALUE' and message.param_id == 'LOG_DISARMED' and p.read_requested:
+                if message.param_value == p.value:
+                    self._completed('PARAM_VALUE')
+            if p.kind == 'src' and kind == 'COMMAND_ACK' and message.command == 42007 and (
+                    message.target_system, message.target_component) in ((255, 190),):
+                if p.ack is None:
+                    p.ack = 'ACCEPTED' if message.result == 0 else 'REJECTED'
+                    self.trace.push('src_ack', disposition=p.ack)
+                    if p.ack != 'ACCEPTED':
+                        self._stop('SRC_ACK_REJECTED')
+
+    def _completed(self, evidence):
+        p = self.pending
+        self.last_action = dict(kind=p.kind, value=p.value, readback=evidence, ack=p.ack)
+        self.trace.push('action_readback', **self.last_action)
+        if self.store is not None:
+            self.confirmed.append(dict(self.last_action, restoring=self.restoring))
+            # Durably planned before first mutation; confirmations are queued.
+            self.store.note(self.confirmed, 'RESTORING' if self.restoring else 'PENDING')
+
+        if self.restoring and p.kind == 'log' and p.value == self.old['log_disarmed']:
+            self.log_dirty = False
+        if self.restoring and p.kind == 'src' and p.value == self.old['source']:
+            self.src_dirty = False
+        self.pending = None
+
+    def tick(self, fd):
+        with self.lock:
+            self._expire()
+            if self.stopped and not self.write_active and not self.driver_empty and not self.write_fault:
+                try:
+                    self.driver_empty = self.driver_queue_empty(fd) is True
+                except OSError:
+                    self.write_fault = True
+            if (self.stopped and not self.write_active and self.driver_empty and not self.write_fault
+                    and self.pending is None and (self.src_dirty or self.log_dirty)
+                    and self.restore_eligible()):
+                self.restoring = True
+            now = self.clock()
+            p = self.pending
+            if p is not None:
+                if p.sent and p.kind == 'src' and p.ack == 'ACCEPTED' and now < p.deadline:
+                    if self.source_reader is not None and self.source_reader() == p.value:
+                        self._completed('INDEPENDENT_SRC')
+                        return
+                if now >= p.deadline or (self.stopped and not self.restoring):
+                    self.last_action = dict(kind=p.kind, value=p.value, readback=None, ack=p.ack)
+                    self.pending = None
+                    self._stop('DIAGNOSTIC_READBACK_MISSING')
+                    if self.restoring:
+                        self.restore_failed = True
+                    return
+                if not p.sent or (p.kind == 'log' and not p.read_requested):
+                    if not (self.restore_eligible() if self.restoring else self.guard()):
+                        self._stop('ACTION_GUARD_FAILED')
+                        self.restore_failed |= self.restoring
+                        return
+                    try:
+                        if not p.sent:
+                            self.action(fd, p.kind, p.value)
+                            p.sent = True
+                        else:
+                            self.action(fd, 'log_read', p.value)
+                            p.read_requested = True
+                    except OSError:
+                        self._stop('ACTION_WRITE_FAILED')
+                        self.restore_failed |= self.restoring
+                        self.pending = None
+                return
+            if self.restoring and not self.restore_failed and self.restore_eligible():
+                if self.src_dirty:
+                    self.pending = Pending('src', self.old['source'], now + 2)
+                elif self.log_dirty:
+                    self.pending = Pending('log', self.old['log_disarmed'], now + 2)
+
