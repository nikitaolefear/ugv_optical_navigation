+"""Bounded scripts backup serviced from the existing Owner RX/tick."""
+import base64
+from secrets import randbits
+from threading import RLock
+from types import coroutine
+
+from .scripts_ftp import FTPError, HEADER, MAX_FILE, ScriptsFTP
+from .stage3 import Refused
+
+OPS = frozenset({'S3_FTP_START', 'S3_FTP_RESULT', 'S3_FTP_FILE', 'S3_FTP_CHUNK', 'S3_FTP_RELEASE'})
+MAX_TOTAL = 2 * 1024 * 1024
+MAX_FILES = 128
+MAX_TIME = 240
+CHUNK = 768
+PEER = (1, 1)
+
+
+@coroutine
+def exchange(request):
+    # Suspend until a later tick supplies a reply. No separate event loop.
+    return (yield request)
+
+
+async def inventory(ftp):
+    todo = [()]
+    directories = set()
+    files = {}
+    while todo:
+        directory = todo.pop()
+        directories.add(directory)
+        for name, size in (await ftp.list_directory(directory)).items():
+            path = (*directory, name)
+            if size is None:
+                todo.append(path)
+            else:
+                files[path] = size
+            if len(files) + len(todo) > MAX_FILES:
+                raise FTPError('inventory limit')
+        # Empty directories count against the traversal budget as well.
+        if len(directories) > MAX_FILES:
+            raise FTPError('directory limit')
+    return files, directories
+
+
+class ScriptsBackup:
+    def __init__(self, clock, allowed, peer_alive, local):
+        self.clock, self.allowed, self.peer_alive = clock, allowed, peer_alive
+        self.local = local
+        self.lock = RLock()
+        self.sequence = randbits(16)
+        self.peer = self.task = self.request = self.reply = None
+        self.sent = False
+        self.deadline = self.reply_deadline = self.next_send = self.retention = 0
+        self.result = 'IDLE'
+        self.reason = None
+        self.files = []
+        self.unresolved = False
+        self.ftp = None
+
+    def guard(self):
+        if not self.allowed() or self.clock() >= self.deadline:
+            raise FTPError('FTP_GUARD_OR_DEADLINE')
+
+    def operate_guard(self):
+        self.guard()
+        if not self.peer_alive(self.peer):
+            raise FTPError('FTP_PEER_GONE')
+
+    async def run(self, budget):
+        self.operate_guard()
+        if not (await exchange(None)) & 0x20:
+            raise FTPError('FTP_CAPABILITY_ABSENT')
+        first, directories = await inventory(self.ftp)
+        total = sum(first.values())
+        # Count protocol overhead before opening any file.
+        if total > budget or any(size > MAX_FILE for size in first.values()):
+            raise FTPError('FTP_SIZE_LIMIT')
+        for parts, size in sorted(first.items()):
+            contents, digest, crc = await self.ftp.fetch_file(parts, size)
+            if crc is None:
+                other, repeated, _ = await self.ftp.fetch_file(parts, size)
+                if repeated != digest or other != contents:
+                    raise FTPError('FTP_REPEAT_MISMATCH')
+            self.files.append((parts, contents, digest, crc))
+        if (first, directories) != await inventory(self.ftp):
+            raise FTPError('FTP_TREE_CHANGED')
+        self.operate_guard()
+
+    def _finish(self, reason):
+        self.result = reason
+        self.retention = self.clock() + 180
+        self.unresolved |= self.ftp.session_uncertain
+        self.sequence = self.ftp._sequence
+        self.task = self.request = self.reply = None
+        if reason != 'COMPLETE':
+            self.files.clear()
+
+    def _advance(self, value=None, error=None):
+        try:
+            self.request = self.task.throw(error) if error else self.task.send(value)
+        except StopIteration:
+            self._finish('COMPLETE')
+        except (FTPError, OSError) as error:
+            self.reason = str(error) if isinstance(error, FTPError) else 'FTP_IO_ERROR'
+            self._finish('INCOMPLETE')
+        self.sent = False
+        self.reply = None
+
+    def dispatch(self, peer, op, payload, *, other_busy=False):
+        with self.lock:
+            if op == 'S3_FTP_START':
+                budget = payload.get('budget')
+                retained = (self.peer is not None and self.clock() < self.retention
+                            and self.peer_alive(self.peer))
+                if (self.task is not None or retained or self.unresolved or other_busy or not self.allowed()
+                        or not self.peer_alive(peer) or set(payload) != {'budget'}
+                        or type(budget) is not int or not 0 <= budget <= MAX_TOTAL):
+                    raise Refused('FTP_START_REFUSED')
+                self.peer, self.deadline = peer, self.clock() + MAX_TIME
+                self.files.clear()
+                self.result = 'BUSY'
+                self.reason = None
+                self.ftp = ScriptsFTP(exchange, self.operate_guard, self.sequence)
+                self.task = self.run(budget)
+                self._advance()
+                return {'queued': True}
+            if (peer != self.peer or not self.peer_alive(peer) or not self.allowed()
+                    or (self.task is None and self.clock() >= self.retention)):
+                raise Refused('FTP_PEER_OR_GUARD')
+            if op == 'S3_FTP_RESULT' and not payload:
+                return dict(status=self.result, count=len(self.files) if self.result == 'COMPLETE' else 0,
+                            unresolved=self.unresolved, reason=self.reason)
+            if op == 'S3_FTP_RELEASE' and not payload and self.task is None:
+                self.files.clear()
+                self.peer = None
+                return {'released': True}
+            index = payload.get('index')
+            if self.result != 'COMPLETE' or type(index) is not int or not 0 <= index < len(self.files):
+                raise Refused('FTP_BACKUP_UNAVAILABLE')
+            parts, data, digest, crc = self.files[index]
+            if op == 'S3_FTP_FILE' and set(payload) == {'index'}:
+                return dict(parts=parts, size=len(data), sha256=digest, crc32=crc)
+            offset = payload.get('offset')
+            if (op == 'S3_FTP_CHUNK' and set(payload) == {'index', 'offset'}
+                    and type(offset) is int and 0 <= offset < len(data)):
+                return dict(offset=offset, base64=base64.b64encode(data[offset:offset+CHUNK]).decode())
+            raise Refused('FTP_INVALID_REQUEST')
+
+    def tick(self, send, *, connected, priority_clear):
+        with self.lock:
+            if self.task is None:
+                if self.peer is not None and (self.clock() >= self.retention or not self.peer_alive(self.peer)):
+                    self.files.clear()
+                    self.peer = None
+                return
+            now = self.clock()
+            if not connected or not self.allowed() or not self.peer_alive(self.peer) or now >= self.deadline:
+                self._advance(error=FTPError('FTP_GUARD_LOST'))
+                return
+            if self.reply is not None:
+                self._advance(self.reply)
+                return
+            if self.sent and now >= self.reply_deadline:
+                # A file coroutine can enqueue its own TerminateSession here.
+                self._advance(error=FTPError('FTP_TIMEOUT'))
+                return
+            if self.sent or not priority_clear or now < self.next_send:
+                return
+            try:
+                self.operate_guard()
+                send(self.request)
+                self.sent = True
+                self.reply_deadline = now + 1
+                self.next_send = now + .025
+            except (FTPError, OSError):
+                self._advance(error=FTPError('FTP_SEND_FAILED'))
+
+    def observe(self, msg):
+        with self.lock:
+            if (self.task is None or not self.sent or self.reply is not None
+                    or self.clock() >= self.reply_deadline
+                    or (msg.get_srcSystem(), msg.get_srcComponent()) != PEER):
+                return
+            if self.request is None:
+                if msg.get_type() == 'AUTOPILOT_VERSION':
+                    self.reply = int(msg.capabilities)
+                return
+            if (msg.get_type() != 'FILE_TRANSFER_PROTOCOL' or msg.target_network != 0
+                    or (msg.target_system, msg.target_component) != self.local):
+                return
+            data = bytes(msg.payload)
+            if len(data) == 251 and HEADER.unpack_from(data)[0] == ((HEADER.unpack_from(self.request)[0] + 1) & 0xffff):
+                self.reply = data
