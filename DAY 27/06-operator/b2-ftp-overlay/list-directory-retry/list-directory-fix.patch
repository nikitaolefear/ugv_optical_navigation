 class FTPError(RuntimeError):
     pass
+
+
+class DirectoryError(FTPError):
+    def __init__(self, reason, reply):
+        super().__init__(reason)
+        seq, session, opcode, size, request, _, _, offset = HEADER.unpack_from(reply)
+        self.capture = dict(payload_hex=reply.hex(), declared_size=size, offset=offset,
+                            sequence=seq, opcode=opcode, request_opcode=request,
+                            session_id=session, reason=reason)
+
+
+def directory_records(data):
+    cursor = 0
+    while cursor < len(data):
+        end = data.find(b"\0", cursor)
+        if end == -1 or end == cursor:
+            raise FTPError("invalid directory record delimiter")
+        yield data[cursor:end]
+        cursor = end + 1
+        # Rover 4.7.2 counts the explicit NUL and the snprintf terminator.
+        if data[cursor:cursor+1] == b"\0":
+            cursor += 1
 
 
