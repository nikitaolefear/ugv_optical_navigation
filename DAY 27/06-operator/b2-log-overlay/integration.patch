+"""Bounded metadata-only collector for the existing Owner's parameter stream."""
+import hashlib
+
+from pymavlink.dialects.v20 import ardupilotmega as mav
+
+from .log_disarmed import PARAMETER, Refused
+
+MAX_ENTRIES = 4096
+MAX_FRAMES = MAX_ENTRIES * 3
+LIST_SECONDS = 60
+
+
+class Inventory:
+    def __init__(self):
+        self.entries = {}
+        self.names = {}
+        self.count = None
+        self.frames = 0
+        self.target = None
+
+    def add(self, message):
+        self.frames += 1
+        if self.frames > MAX_FRAMES:
+            raise Refused('LOG_DISCOVERY_FRAME_LIMIT')
+        index, count, name, kind = (message.param_index, message.param_count,
+                                   message.param_id, message.param_type)
+        if index == 65535:
+            return False  # Named reply or PARAM_SET echo cannot prove inventory.
+        if (not 0 < count <= MAX_ENTRIES or not 0 <= index < count
+                or not name or not name.isascii() or len(name) > 16
+                or any(ord(c) < 33 or ord(c) > 126 for c in name)
+                or not mav.MAV_PARAM_TYPE_UINT8 <= kind <= mav.MAV_PARAM_TYPE_REAL64
+                or (self.count is not None and self.count != count)):
+            raise Refused('LOG_DISCOVERY_INVALID_METADATA')
+        self.count = count
+        key = hashlib.blake2s(name.encode(), digest_size=16).digest()
+        row = (key, kind)
+        if self.entries.get(index, row) != row or self.names.get(key, index) != index:
+            raise Refused('LOG_DISCOVERY_AMBIGUOUS_INDEX')
+        self.entries[index] = row
+        self.names[key] = index
+        if name == PARAMETER:
+            if kind != mav.MAV_PARAM_TYPE_INT8 or message.param_value not in (0, 1, 2, 3):
+                raise Refused('LOG_DISCOVERY_INVALID_TARGET')
+            target = (index, kind, int(message.param_value))
+            if self.target is not None and self.target != target:
+                raise Refused('LOG_DISCOVERY_TARGET_CHANGED')
+            self.target = target
+        if len(self.entries) != count:
+            return False
+        if self.target is None:
+            raise Refused('LOG_DISCOVERY_TARGET_MISSING')
+        return True
