+"""Single-slot handoff to the existing Owner tick. Disk work stays in worker."""
+from hashlib import sha256
+import os
+from pathlib import Path
+import stat
+import threading
+import uuid
+
+from .log_disarmed import GUARDS, Journal, Refused, Transaction, identity
+from .owner_port import LogDisarmedPort, TARGET, mav
+from .log_discovery import Inventory, LIST_SECONDS
+
+OPS = frozenset({'S3_LOG_STATUS', 'S3_LOG_BEGIN', 'S3_LOG_RESTORE', 'S3_LOG_RECOVER', 'S3_LOG_RESULT', 'S3_LOG_DISCOVER'})
+QUIET = .30
+
+
+class LogQueue:
+    def __init__(self, clock, directory, marker, pi_boot, port_path, gateway_uid, root_attested,
+                 peer_alive, safety):
+        self.clock, self.marker, self.port_path = clock, marker, port_path
+        self.pi_boot, self.root_attested, self.peer_alive = pi_boot.replace('-', ''), root_attested, peer_alive
+        self.safety = safety
+        self.fault = False
+        self.lock = threading.Lock()
+        self.slot = None
+        self.last_param = float('-inf')
+        self.session = uuid.uuid4().hex
+        self.current = {}
+        self.link = None
+        self.fc_time = None
+        self.job = self.peer = self.result = None
+        self.journal = Journal(directory)
+        self.gateway_uid = gateway_uid
+        self.discovery = None
+
+    def identity(self):
+        return self.current.copy()
+
+    def authorized(self, peer, action, transaction, current):
+        if not self.peer_alive(peer):
+            return False
+        binding = ' '.join(current[key] for key in ('hardware', 'pi_boot', 'fc_boot', 'owner_session'))
+        return self.root_attested(self.marker, f'B2-LOG {binding} {action} '
+                                  f'{transaction if action not in ("begin", "discover") else "-"}')
+
+    def verified(self):
+        record = self.discovery
+        return record if record is not None and record['identity'] == self.current else None
+
+    def discover(self, peer):
+        current = identity(self.identity())
+
+        def guard():
+            state = self.safety()
+            if (self.identity() != current or not self.authorized(peer, 'discover', '-', current)
+                    or any(state.get(key) is not True for key in GUARDS)):
+                raise Refused('LOG_DISCOVERY_GUARD_LOST')
+
+        guard()
+        inventory = Inventory()
+        self.exchange(mav.MAVLink_param_request_list_message(*TARGET), guard, LIST_SECONDS, inventory.add)
+        index, kind, value = inventory.target
+        port = LogDisarmedPort(self.exchange, self.identity, self.safety, index)
+        # This separate request must follow a quiet window after the full list.
+        readback = port.read_log_disarmed(guard, expected_count=inventory.count)
+        guard()
+        if readback != value:
+            raise Refused('LOG_DISCOVERY_READBACK_MISMATCH')
+        return dict(identity=current, param_id='LOG_DISARMED', index=index,
+                    param_type=kind, value=readback, count=inventory.count)
+
+    def observe(self, message):
+        if (message.get_srcSystem(), message.get_srcComponent()) != (1, 1):
+            return
+        kind = message.get_type()
+        if kind in ('SYSTEM_TIME', 'ATTITUDE'):
+            value = int(message.time_boot_ms)
+            if self.fc_time is not None and value + 1000 < self.fc_time:
+                self.link = None
+                self.current = {}
+                self.fc_time = None
+            self.fc_time = max(self.fc_time or 0, value)
+        if kind != 'PARAM_VALUE':
+            return
+        with self.lock:
+            self.last_param = self.clock()
+            slot = self.slot
+            if not (slot and not slot['done'].is_set() and slot.get('sent')
+                    and self.clock() < slot['expires'] and slot['accept'] is not None):
+                return
+            try:
+                if slot['accept'](message):
+                    slot['reply'] = message
+                    slot['done'].set()
+            except Refused as error:
+                slot['error'] = error
+                slot['done'].set()
+
+    def exchange(self, message, check, timeout, accept):
+        done = threading.Event()
+        with self.lock:
+            if self.slot is not None:
+                raise Refused('LOG_QUEUE_BUSY')
+            slot = dict(message=message, check=check, expires=self.clock()+timeout,
+                        accept=accept, done=done)
+            self.slot = slot
+        try:
+            if not done.wait(timeout):
+                with self.lock:
+                    self.fault = True
+                raise TimeoutError('LOG_REQUEST_TIMEOUT')
+            if 'error' in slot:
+                raise slot['error']
+            return slot.get('reply')
+        finally:
+            with self.lock:
+                if self.slot is slot:
+                    self.slot = None
+
+    def tick(self, fd, send, *, connected, epoch, priority_clear):
+        # Serial identity is tied to this Owner descriptor, not to a caller.
+        if not connected:
+            self.current = {}
+            self.link = None
+            self.fc_time = None
+        elif self.link != (fd, epoch) and self.fc_time is not None:
+            try:
+                device = Path(self.port_path)
+                live = device.stat()
+                opened = os.fstat(fd)
+                if not (device.is_symlink() and stat.S_ISCHR(opened.st_mode)
+                        and (live.st_dev, live.st_ino, live.st_rdev) ==
+                            (opened.st_dev, opened.st_ino, opened.st_rdev)):
+                    raise ValueError('link mismatch')
+                hardware = sha256(device.name.encode()).hexdigest()
+                self.current = dict(hardware=hardware, pi_boot=self.pi_boot,
+                                    fc_boot=uuid.uuid4().hex, owner_session=self.session)
+                self.link = (fd, epoch)
+            except (OSError, ValueError):
+                self.current = {}
+        with self.lock:
+            slot = self.slot
+            if not slot or slot['done'].is_set():
+                return
+            now = self.clock()
+            try:
+                if now >= slot['expires'] or not connected:
+                    if slot.get('sent'):
+                        self.fault = True
+                    raise Refused('LOG_REQUEST_EXPIRED_OR_LINK_LOST')
+                slot['check']()
+                if slot.get('sent') or not priority_clear:
+                    return
+                if slot['accept'] is not None and now-self.last_param < QUIET:
+                    return
+                slot['check']()
+                if self.clock() >= slot['expires']:
+                    raise Refused('LOG_REQUEST_EXPIRED')
+                send(slot['message'])
+                slot['sent'] = True
+                self.last_param = self.clock()
+                if slot['accept'] is None:
+                    slot['done'].set()
+            except Exception as error:
+                if slot.get('sent'):
+                    self.fault = True
+                slot['error'] = error
+                slot['done'].set()
+
+    def status(self, other_job, logs_busy):
+        with self.lock:
+            active, queued = self.job, int(self.slot is not None and not self.slot.get('sent'))
+        try:
+            record = self.journal.load()
+            pending = record if record and record['phase'] != 'restored' else None
+        except (OSError, ValueError, KeyError, TypeError, Refused):
+            pending = {'phase': 'invalid'}
+        return dict(profile='B2-LOG', identity=self.identity(), active=active or other_job,
+                    queued=queued + int(other_job is not None and not logs_busy), transport_fault=self.fault, unfinished=pending and {k: pending.get(k) for k in ('transaction','phase')},
+                    recovery_required=bool(pending) and active is None,
+                    discovery=self.verified(),
+                    dataflash='ACTIVE_OR_END_OWED' if logs_busy else 'IDLE')
+
+    def dispatch(self, peer, op, payload, *, other_job, logs_busy):
+        if op == 'S3_LOG_STATUS' and not payload:
+            return self.status(other_job, logs_busy)
+        with self.lock:
+            if op == 'S3_LOG_RESULT' and not payload and peer == self.peer:
+                return dict(active=self.job, result=self.result)
+            action = {'S3_LOG_BEGIN':'begin','S3_LOG_RESTORE':'restore','S3_LOG_RECOVER':'recover', 'S3_LOG_DISCOVER':'discover'}.get(op)
+            fields = set() if action in ('begin', 'discover') else {'transaction'}
+            if (action is None or set(payload) != fields or self.job or other_job or logs_busy
+                    or self.fault or not self.peer_alive(peer)):
+                raise Refused('LOG_OPERATION_REFUSED')
+            proof = self.verified()
+            if action == 'discover':
+                self.discovery = None
+            elif proof is None:
+                raise Refused('LOG_DISCOVERY_REQUIRED')
+            self.job, self.peer, self.result = action, peer, None
+        def run():
+            try:
+                if action == 'discover':
+                    result = self.discover(peer)
+                    self.discovery = result
+                else:
+                    def authorized(p, act, transaction, current):
+                        return (self.verified() == proof
+                                and self.authorized(p, act, transaction, current))
+
+                    port = LogDisarmedPort(self.exchange, self.identity, self.safety,
+                                           proof['index'], proof['count'])
+                    transaction = Transaction(self.journal, port, gateway_uid=self.gateway_uid,
+                                              authorized=authorized, profile='B2-LOG')
+                    row = transaction.execute(peer, action, payload)
+                    result = {k: row[k] for k in ('transaction', 'phase', 'baseline')}
+            except (Refused, TimeoutError, OSError, ValueError, KeyError, TypeError):
+                result = {'error':'LOG_FAILED_CHECK_STATUS_AND_JOURNAL'}
+            finally:
+                with self.lock:
+                    self.result = locals().get('result', {'error':'LOG_WORKER_INTERRUPTED'})
+                    self.job = None
+        threading.Thread(target=run, daemon=True, name='log-disarmed').start()
+        return {'queued':True}
