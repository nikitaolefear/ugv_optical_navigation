+"""Single-Owner B3 test lease. No serial opener and no client-supplied frames."""
+import hashlib
+import re
+import os
+import select
+import threading
+import time
+
+from .stage3 import Refused, IDLE
+
+OPS = frozenset({'S3_B3_STATUS','S3_B3_OPEN','S3_B3_RENEW','S3_B3_REVOKE','S3_B3_ROW'})
+SCENARIOS = frozenset({'revoke','client_exit','expiry'})
+CAP = 64
+RATE = .1
+
+
+def watch_pid(peer):
+    fd = os.pidfd_open(peer[1])
+    try:
+        poll = select.poll()
+        poll.register(fd, select.POLLIN)
+        return fd, poll
+    except Exception:
+        os.close(fd)
+        raise
+
+
+class BenchLease:
+    def __init__(self, clock, identity, alive, approved, guard, pose, encode, write,
+                 ns=time.monotonic_ns, qualified=lambda: True, watch=None):
+        self.clock, self.identity, self.alive, self.approved = clock, identity, alive, approved
+        self.guard, self.pose, self.encode, self.write, self.ns = guard, pose, encode, write, ns
+        self.qualified = qualified
+        self.watch = watch
+        self.pidwatch = None
+        self.failure = None
+        self.safety_lost = False
+        self.trace_drops = 0
+        self.last_syscall_ns = None
+        self.stage = "idle"
+        self.lock = threading.RLock()
+        self.lease = None
+        self.request = None
+        self.used = set()
+        self.rows = []
+        self.stop = None
+        self.fault = False
+        self.sent_total = 0
+        self.last_pose = None
+        self.last_write = float('-inf')
+
+    def drop_watch(self):
+        watch, self.pidwatch = self.pidwatch, None
+        if watch is not None:
+            os.close(watch[0])
+
+    def invoke(self, name, fn, *args):
+        self.stage = name
+        try:
+            return fn(*args)
+        except Refused as error:
+            raise RuntimeError('internal callback refused') from error
+
+    def emergency(self, error):
+        # Disable before best-effort diagnostic or pidfd cleanup.
+        self.lease = self.request = None
+        self.fault = self.safety_lost = True
+        self.stop = None
+        self.failure = dict(reason='internal_fault', callback=self.stage,
+                            exception=type(error).__name__)
+        try:
+            self.drop_watch()
+        except Exception as cleanup:
+            self.failure['cleanup_exception'] = type(cleanup).__name__
+
+    def close(self, reason, trigger=None, ipc=None):
+        item = self.lease or self.request
+        self.lease = self.request = None
+        if item is not None:
+            self.safety_lost |= reason not in ('revoke','client_exit','expiry','hard_limit')
+            instant = self.invoke('stop_clock', self.ns)
+            self.stop = dict(reason=reason, trigger_ns=trigger, gate_ns=instant,
+                             barrier_ns=self.invoke('barrier_clock', self.ns),
+                             last_syscall_ns=self.last_syscall_ns,
+                             lease_start_ns=item.get('start_ns'),
+                             last_renew_ns=item.get('renew_ns'), scenario=item['scenario'],
+                             lease=item['nonce'], peer=list(item['peer']),
+                             ipc=ipc, safety_lost=self.safety_lost, trace_drops=self.trace_drops)
+        self.invoke('watch_cleanup', self.drop_watch)
+
+    def _expire(self):
+        if not self.lease:
+            return
+        l = self.lease
+        now = self.invoke("clock", self.clock)
+        exited = self.invoke("pidfd_poll", self.pidwatch[1].poll, 0) if self.pidwatch else False
+        if (self.invoke('identity',self.identity) != l['identity']
+                or not self.invoke('approval',self.approved,l)
+                or not self.invoke('guard',self.guard)):
+            self.close('guard_lost')
+        elif exited or not self.invoke("peer_alive", self.alive, l["peer"]):
+            self.close('client_exit')
+        elif now >= l['deadline']:
+            self.close('expiry', l['renew_ns'])
+        elif now >= l['hard']:
+            self.close('hard_limit')
+
+    def active(self):
+        with self.lock:
+            return self.lease is not None or self.request is not None
+
+    def dispatch(self, peer, op, body, ipc=None):
+        with self.lock:
+            try:
+                return self._dispatch(peer, op, body, ipc)
+            except Refused:
+                raise
+            except Exception as error:
+                self.emergency(error)
+                raise Refused('B3_INTERNAL_FAULT') from error
+
+    def _dispatch(self, peer, op, body, ipc):
+        with self.lock:
+            if op == 'S3_B3_STATUS' and not body:
+                return dict(active=self.active(), fault=self.fault, stop=self.stop,
+                            count=len(self.rows), failure=self.failure, safety_lost=self.safety_lost,
+                            trace_drops=self.trace_drops, start_ns=self.lease and self.lease['start_ns'])
+            if op == 'S3_B3_ROW' and set(body)=={'index'}:
+                index=body['index']
+                if self.active() or type(index) is not int or not 0 <= index < len(self.rows):
+                    raise Refused('B3_TRACE_UNAVAILABLE')
+                return self.rows[index]
+            if op == 'S3_B3_OPEN':
+                if (set(body) != {'scenario','nonce'} or self.active() or self.fault
+                        or not isinstance(body['scenario'],str) or body['scenario'] not in SCENARIOS
+                        or not isinstance(body['nonce'],str) or not re.fullmatch('[0-9a-f]{32}',body['nonce'])
+                        or body['nonce'] in self.used or len(self.used)>=16 or not self.invoke('peer_alive',self.alive,peer)):
+                    raise Refused('B3_OPEN_REFUSED')
+                i=self.invoke('identity',self.identity)
+                if not i:
+                    raise Refused('B3_IDENTITY_REQUIRED')
+                request=dict(peer=peer,identity=i,scenario=body['scenario'],nonce=body['nonce'])
+                if not self.invoke('approval',self.approved,request) or not self.invoke('guard',self.guard):
+                    raise Refused('B3_OPEN_REFUSED')
+                if self.watch is not None:
+                    self.pidwatch = self.invoke('pidfd_open',self.watch,peer)
+                    if not self.invoke('peer_alive',self.alive,peer):
+                        self.drop_watch()
+                        raise Refused('B3_PEER_EXITED')
+                self.request=request
+                self.used.add(body['nonce'])
+                self.rows.clear()
+                self.stop=None
+                self.last_syscall_ns=None
+                self.safety_lost=False
+                self.trace_drops=0
+                return {'queued':True}
+            if body:
+                raise Refused('B3_UNEXPECTED_PAYLOAD')
+            if op == 'S3_B3_REVOKE' and any(x and x['peer']==peer for x in (self.lease,self.request)):
+                if self.lease and not self.invoke('guard',self.guard):
+                    self.safety_lost = True
+                self.close('revoke',ipc=ipc)
+                return {'closed':True}
+            if op == 'S3_B3_RENEW' and self.lease and self.lease['peer']==peer:
+                self._expire()
+                if self.lease:
+                    self.lease.update(deadline=self.invoke('clock',self.clock)+IDLE,renew_ns=self.invoke('renew_clock',self.ns))
+                    return {'renewed':True}
+            raise Refused('B3_OPERATION_REFUSED')
+
+    def tick(self, fd):
+        with self.lock:
+            try:
+                self.send_tick(fd)
+            except Exception as error:
+                self.emergency(error)
+
+    def send_tick(self, fd):
+        # This lock spans final guard and the single nonblocking syscall:
+        # revocation linearizes after any syscall already holding this lock.
+        with self.lock:
+            if self.request:
+                now=self.clock()
+                ns=self.ns()
+                self.lease=dict(self.request,deadline=now+IDLE,hard=now+5,start_ns=ns,renew_ns=ns)
+                self.request=None
+            self._expire()
+            if not self.lease or self.clock()-self.last_write < RATE:
+                return
+            pose=self.invoke('pose',self.pose)
+            if pose is None or not 0 <= self.clock()-pose['acquired_at'] <= .2:
+                self.close('pose_stale')
+                return
+            if pose['sequence']==self.last_pose:
+                return
+            if len(self.rows)>=CAP:
+                self.fault=True
+                self.trace_drops+=1
+                self.close('trace_capacity')
+                return
+            raw, meta=self.invoke('encoder', self.encode,pose)
+            if not self.invoke('alignment',self.qualified):
+                self.close('alignment_unverified')
+                return
+            self._expire()
+            if not self.lease:
+                return
+            if not 0 <= self.clock()-pose['acquired_at'] <= .2:
+                self.close('pose_stale')
+                return
+            l=self.lease
+            row=dict(meta,event='tx',sha256=hashlib.sha256(raw).hexdigest(),
+                     size=len(raw),lease=l['nonce'],session=l['identity']['owner_session'])
+            self.last_pose=pose['sequence']
+            row['enter_ns']=self.ns()
+            try:
+                row['written']=self.invoke('writer',self.write,fd,raw)
+            except OSError as e:
+                row.update(written=-1,errno=e.errno)
+            row['exit_ns']=self.ns()
+            self.last_syscall_ns=row['exit_ns']
+            try:
+                self.invoke('trace',self.rows.append,row)
+            except Exception:
+                self.trace_drops+=1
+                raise
+            self.last_write=self.clock()
+            if row['written']==len(raw):
+                self.sent_total += 1
+            else:
+                self.fault=True
+                self.close('serial_write_fault')
