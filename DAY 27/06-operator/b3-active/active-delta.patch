+"""Fixed transport probe for pinned Rover 4.7.2, no i/o."""
+from pymavlink.dialects.v20 import ardupilotmega as mav
+from .log_disarmed import GUARDS
+
+
+def send_guard(state, pwm, *, heartbeat_age, src, transport_fault, conflicting,
+               disarm_pending, observe_only):
+    return (all(state.get(key) is True for key in GUARDS)
+            and heartbeat_age is not None and 0 <= heartbeat_age <= 1
+            and all(pwm[str(i)]['state']=='FRESH' and pwm[str(i)]['pwm_us']==999
+                    for i in (5,6))
+            and src == 1 and not transport_fault and not conflicting
+            and not disarm_pending and observe_only)
+
+
+def probe_packet(pose, encoder):
+    # Rover 4.7.2 rejects LOCAL_NED here before invoking VisualOdom.
+    # Keep the ODOMETRY wire schema, but use a known synthetic NED sample.
+    cov = [float('nan')] + [0.0]*20
+    usec = int(pose['acquired_at']*1e6)
+    seq = encoder.seq
+    msg = mav.MAVLink_odometry_message(
+        usec, mav.MAV_FRAME_LOCAL_NED, mav.MAV_FRAME_BODY_FRD,
+        .125,-.25,.375,[1.,0.,0.,0.], .125,-.25,.375,0.,0.,0.,
+        cov,cov,0,mav.MAV_ESTIMATOR_TYPE_VISION,-1)
+    raw = msg.pack(encoder)
+    encoder.seq = (seq+1)%256
+    return raw, dict(id=331,seq=seq,sys=encoder.srcSystem,
+                     comp=encoder.srcComponent,usec=usec)
+
+
+def approval_record(lease):
+    i = lease['identity']
+    binding = ' '.join(i[k] for k in ('hardware','pi_boot','fc_boot','owner_session'))
+    _, pid, generation = lease['peer']
+    return f"B3 {binding} {pid} {generation} {lease['scenario']} {lease['nonce']}"
